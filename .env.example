# ==========================================
# Ollama 로컬 LLM 설정
# ==========================================
# 기본 모델: llama3.2, llama3.1, mistral, qwen2.5 등
OLLAMA_MODEL=ollama/llama3.2
OLLAMA_BASE_URL=http://localhost:11434

